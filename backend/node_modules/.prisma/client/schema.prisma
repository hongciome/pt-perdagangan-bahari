datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id            String           @id @default(uuid())
  sku           String           @unique
  name          String
  category      String           @default("Ikan Laut")
  unit          String           @default("KG")
  minStock      Float            @default(50)
  standardCost  Decimal          @db.Decimal(12, 2)
  standardPrice Decimal          @db.Decimal(12, 2)
  isActive      Boolean          @default(true)
  batches       InventoryBatch[]
}

model Customer {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  type        String
  phone       String
  address     String
  creditLimit Decimal @db.Decimal(14, 2)
  isActive    Boolean @default(true)
}

model Supplier {
  id            String  @id @default(uuid())
  code          String  @unique
  name          String
  contactPerson String
  phone         String
  originRegion  String
  bankAccount   String
  isActive      Boolean @default(true)
}

model SalesOrder {
  id           String   @id @default(uuid())
  soNumber     String   @unique
  totalAmount  Decimal  @db.Decimal(14, 2)
  totalCostHpp Decimal  @default(0) @db.Decimal(14, 2)
  createdAt    DateTime @default(now())
  status       String   @default("CONFIRMED")
}

model InventoryBatch {
  id           String   @id @default(uuid())
  batchNumber  String   @unique
  productId    String
  currentQtyKg Float
  receivedAt   DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String   @id @default(uuid())
  invNumber     String   @unique
  totalAmount   Decimal  @db.Decimal(14, 2)
  paymentStatus String   @default("UNPAID")
  createdAt     DateTime @default(now())
}
